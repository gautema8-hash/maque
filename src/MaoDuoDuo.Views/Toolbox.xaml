<UserControl x:Class="MaoDuoDuo.Views.Toolbox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:ZdfFlatUI;assembly=WPF.UI">
    <UserControl.Resources>
        <Style x:Key="ToolCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Width" Value="190"/>
            <Setter Property="Height" Value="92"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="BorderBrush" Value="#E3E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="ToolTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="ToolDesc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#8892A6"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="10">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="#FFF6E5" CornerRadius="8" Padding="12,8" Margin="0,0,0,12">
                    <TextBlock FontSize="12" Foreground="#A26B00" TextWrapping="Wrap"
                               Text="提示：「一键卡大促 / 卡反拼单 / 仅退款申诉 / 批量下架」需先在【任务设置 → 商品ID】中填写商品ID，并在拼夕夕/商户页完成登录；点击下方卡片等同点击任务设置页对应按钮。"/>
                </Border>
                <TextBlock Text="店铺运营工具" FontSize="14" FontWeight="Bold" Foreground="#2B5FDB" Margin="0,0,0,8"/>
                <WrapPanel>
                    <Border Style="{StaticResource ToolCard}" MouseLeftButtonDown="Kdc_Click">
                        <StackPanel VerticalAlignment="Center" Margin="12">
                            <TextBlock Style="{StaticResource ToolTitle}" Text="一键卡大促"/>
                            <TextBlock Style="{StaticResource ToolDesc}" Text="自动报名平台大促活动，需先填写商品ID并登录商户"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ToolCard}" MouseLeftButtonDown="Fan_Click">
                        <StackPanel VerticalAlignment="Center" Margin="12">
                            <TextBlock Style="{StaticResource ToolTitle}" Text="卡反拼单"/>
                            <TextBlock Style="{StaticResource ToolDesc}" Text="创建推广并自动改价完成卡低拼单流程"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ToolCard}" MouseLeftButtonDown="Off_Click">
                        <StackPanel VerticalAlignment="Center" Margin="12">
                            <TextBlock Style="{StaticResource ToolTitle}" Text="批量下架"/>
                            <TextBlock Style="{StaticResource ToolDesc}" Text="对商户后台在售商品执行批量下架"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ToolCard}" MouseLeftButtonDown="Tk_Click">
                        <StackPanel VerticalAlignment="Center" Margin="12">
                            <TextBlock Style="{StaticResource ToolTitle}" Text="仅退款申诉"/>
                            <TextBlock Style="{StaticResource ToolDesc}" Text="图像识别驱动的外部窗口自动申诉流程"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ToolCard}" MouseLeftButtonDown="Tk2_Click">
                        <StackPanel VerticalAlignment="Center" Margin="12">
                            <TextBlock Style="{StaticResource ToolTitle}" Text="仅退款申诉2"/>
                            <TextBlock Style="{StaticResource ToolDesc}" Text="售后单详情页自动申诉（备用通道）"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>
                <TextBlock Text="设置与计算" FontSize="14" FontWeight="Bold" Foreground="#2B5FDB" Margin="0,4,0,8"/>
                <WrapPanel>
                    <Border Style="{StaticResource ToolCard}" MouseLeftButtonDown="Monitor_Click">
                        <StackPanel VerticalAlignment="Center" Margin="12">
                            <TextBlock Style="{StaticResource ToolTitle}" Text="监控管理"/>
                            <TextBlock Style="{StaticResource ToolDesc}" Text="刷新商品监控列表（前往「商品监控」页可开始监控）"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ToolCard}" MouseLeftButtonDown="Reason_Click">
                        <StackPanel VerticalAlignment="Center" Margin="12">
                            <TextBlock Style="{StaticResource ToolTitle}" Text="申诉理由设置"/>
                            <TextBlock Style="{StaticResource ToolDesc}" Text="维护仅退款申诉使用的理由模板（每行一条）"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ToolCard}" MouseLeftButtonDown="Imgset_Click">
                        <StackPanel VerticalAlignment="Center" Margin="12">
                            <TextBlock Style="{StaticResource ToolTitle}" Text="图片加工设置"/>
                            <TextBlock Style="{StaticResource ToolDesc}" Text="底图选择与主图/SKU图中图处理开关"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ToolCard}" MouseLeftButtonDown="Compute_Click">
                        <StackPanel VerticalAlignment="Center" Margin="12">
                            <TextBlock Style="{StaticResource ToolTitle}" Text="盈亏计算"/>
                            <TextBlock Style="{StaticResource ToolDesc}" Text="按售价/成本/扣点计算实际投产ROI与推广盈亏"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

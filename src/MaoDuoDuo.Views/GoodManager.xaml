<UserControl x:Class="MaoDuoDuo.Views.GoodManager"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:ZdfFlatUI;assembly=WPF.UI">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="2">
            <TextBlock Text="监控间隔(分钟)：" VerticalAlignment="Center"/>
            <ui:ZComboBox x:Name="box_time" Width="90" Height="30"/>
            <ui:FlatButton x:Name="btnSearch" Content="刷新列表" Width="80" Height="30" Margin="10,0,0,0" Background="#2B5FDB" Foreground="White" Click="btnSearch_Click"/>
            <ui:FlatButton Content="开始监控" Width="90" Height="30" Margin="10,0,0,0" Click="btnMonitor_Click"/>
        </StackPanel>
        <ListBox x:Name="GoodMonitorListView" Grid.Row="1" Margin="2,8"
                 ItemsSource="{Binding GoodMonitorList}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#E2E5EC" BorderThickness="0,0,0,1" Padding="6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Num}" Width="40" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding GoodId}" Width="140" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding GoodName}" Width="320" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <Button Content="查看销量" Click="btnShow_Click" Cursor="Hand" Margin="8,0"/>
                            <Button Content="打开商品" Click="btnOpen_Click" Cursor="Hand" Margin="8,0"/>
                            <Button Content="删除" Click="btnDelete_Click" Cursor="Hand" Margin="8,0"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>

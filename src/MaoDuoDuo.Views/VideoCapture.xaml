<UserControl x:Class="MaoDuoDuo.Views.VideoCapture"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:ZdfFlatUI;assembly=WPF.UI">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="2">
            <TextBlock Text="关键词采集：" VerticalAlignment="Center"/>
            <TextBox x:Name="dy_keyword" Width="260" Height="30"/>
            <ui:FlatButton Content="开始采集" Width="90" Height="30" Margin="8,0,0,0" Background="#2B5FDB" Foreground="White" Click="btnDyCj_Click"/>
            <ui:FlatButton Content="抖音登录" Width="90" Height="30" Margin="8,0,0,0" Click="btnDyLogin_Click"/>
            <ui:FlatButton Content="清空列表" Width="90" Height="30" Margin="8,0,0,0" Click="btnDyClean_Click"/>
            <ui:FlatButton Content="正序" Width="90" Height="30" Margin="8,0,0,0" Click="btnDyPositive_Click"/>
            <ui:FlatButton Content="倒序" Width="90" Height="30" Margin="8,0,0,0" Click="btnDyReverse_Click"/>
            <ui:FlatButton Content="勾选选中" Width="90" Height="30" Margin="8,0,0,0" Click="btnDyChoose_Click"/>
            <ui:FlatButton Content="批量下载" Width="90" Height="30" Margin="8,0,0,0" Click="btnDyAllDown_Click"/>
        </StackPanel>
        <ui:FlatListView x:Name="DyVideoList" Grid.Row="1" Margin="2,8">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="序号" DisplayMemberBinding="{Binding Id}" Width="50"/>
                    <GridViewColumn Header="标题" DisplayMemberBinding="{Binding Desc}" Width="380"/>
                    <GridViewColumn Header="作者名称" DisplayMemberBinding="{Binding NickName}" Width="140"/>
                    <GridViewColumn Header="喜欢人数" DisplayMemberBinding="{Binding DiggCount}" Width="80"/>
                    <GridViewColumn Header="关键词" DisplayMemberBinding="{Binding KeyWord}" Width="120"/>
                    <GridViewColumn Header="操作" Width="80">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="{Binding TextDown}" Click="btnDyDownload_Click" Cursor="Hand"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ui:FlatListView>
        <StackPanel Orientation="Horizontal" Grid.Row="2" Margin="2,6">
            <TextBlock Text="设置保存位置：" VerticalAlignment="Center"/>
            <ui:ChooseBox x:Name="text_Cjpath" Width="380" Height="30" TextChanged="ChooseBox_TextChanged"/>
            <TextBlock x:Name="txt_CJ" Text="" Margin="14,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>

<Window x:Class="MaoDuoDuo.Views.DownWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="文件下载" Height="160" Width="420"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize"
        Background="#F4F5F7" MouseLeftButtonDown="DragWindow">
    <Border Background="White" Margin="12" CornerRadius="6">
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="4,0,4,10">
                <Image DockPanel.Dock="Right" Source="/DuoDuoPuHuo;component/images/win_close.png"
                       Width="16" Height="16" Cursor="Hand" MouseLeftButtonDown="CloseWindow_Click"/>
                <TextBlock Text="文件下载" FontSize="14" FontWeight="Bold" Foreground="#1F2A44" VerticalAlignment="Center"/>
            </DockPanel>
            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="8,0">
                <Label x:Name="lb_down" Content="正在下载..."/>
                <ProgressBar x:Name="pro_down" Height="18" Minimum="0" Maximum="100" Margin="0,12,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>

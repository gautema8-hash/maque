<UserControl x:Class="MaoDuoDuo.Views.Home"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:ZdfFlatUI;assembly=WPF.UI"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ui:ZTabControl x:Name="TabSearch" Height="110">
            <TabItem Header="商品搜索">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10">
                    <ui:ZTextBox x:Name="txtGoodsKey" Width="420" Height="34" Watermark="请输入关键词或商品ID"/>
                    <ui:FlatButton x:Name="btnGoodsSearch" Content="搜索" Width="100" Height="34" Margin="10,0,0,0" Background="#2B5FDB" Foreground="White" Click="BtnGoodSearch_Click"/>
                </StackPanel>
            </TabItem>
            <TabItem Header="店铺搜索">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10">
                    <ui:ZTextBox x:Name="txtStoreKey" Width="420" Height="34" Watermark="请输入关键词或店铺ID"/>
                    <ui:FlatButton x:Name="btnStoreSearch" Content="搜索" Width="100" Height="34" Margin="10,0,0,0" Background="#2B5FDB" Foreground="White" Click="BtnStoreSearch_Click"/>
                </StackPanel>
            </TabItem>
        </ui:ZTabControl>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>
            <lvc:CartesianChart x:Name="cartesianChart1" Margin="6"/>
            <StackPanel Grid.Column="1" Margin="6">
                <TextBlock Text="平台热搜" FontSize="14" FontWeight="Bold" Margin="0,0,0,4"/>
                <ListBox x:Name="HotSearchList" Height="180">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding}" Click="BtnHotSearch_Click" Cursor="Hand"
                                    Background="Transparent" BorderThickness="0" Foreground="#2B5FDB" Padding="4,2"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="入口直达" FontSize="14" FontWeight="Bold" Margin="0,10,0,4"/>
                <ListBox x:Name="DirectEntryList" Height="180">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Word}" Tag="{Binding Url}" Click="BtnDirectEntry_Click" Cursor="Hand"
                                    Background="Transparent" BorderThickness="0" Foreground="#2B5FDB" Padding="4,2"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>

<UserControl x:Class="MaoDuoDuo.Views.UserManage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:ZdfFlatUI;assembly=WPF.UI">
    <UserControl.Resources>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#55627A"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="RowBtn" TargetType="Button">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.82"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 权限提示（非管理员显示） -->
        <Border x:Name="noPermTip" Grid.Row="0" Background="#FFF4E5" CornerRadius="6" Padding="10,8" Margin="0,0,0,10"
                Visibility="Collapsed">
            <TextBlock x:Name="noPermText" Text="当前账号为普通用户，仅管理员可分配/作废/编辑/删除卡密。" FontSize="12" Foreground="#A26B00"/>
        </Border>

        <!-- 分配卡密区（仅管理员可见） -->
        <Border x:Name="genPanel" Grid.Row="1" Background="White" CornerRadius="8" Padding="12"
                BorderBrush="#E3E8F0" BorderThickness="1" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="分配卡密" Grid.Column="0" FontSize="13" FontWeight="Bold" Foreground="#2B5FDB" Margin="0,0,14,0" VerticalAlignment="Center"/>
                <TextBlock Text="有效期" Grid.Column="1" Style="{StaticResource Lbl}" Margin="0,0,6,0"/>
                <TextBox x:Name="txtValue" Grid.Column="2" Height="30" VerticalContentAlignment="Center" Text="1"/>
                <ComboBox x:Name="comboUnit" Grid.Column="3" Height="30" Width="86" Margin="6,0,12,0" SelectedIndex="1">
                    <ComboBoxItem Content="小时" Tag="hour"/>
                    <ComboBoxItem Content="天" Tag="day"/>
                    <ComboBoxItem Content="月" Tag="month"/>
                    <ComboBoxItem Content="年" Tag="year"/>
                </ComboBox>
                <TextBlock Text="备注" Grid.Column="4" Style="{StaticResource Lbl}" Margin="0,0,6,0"/>
                <TextBox x:Name="txtNote" Grid.Column="5" Height="30" Width="120" VerticalContentAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock Grid.Column="6" />
                <ui:FlatButton x:Name="btnGenerate" Grid.Column="7" Content="生成32位卡密" Width="130" Height="32"
                               Background="#2B9F5F" Foreground="White" Click="btnGenerate_Click"/>
            </Grid>
        </Border>

        <!-- 查询区 -->
        <Border Grid.Row="2" Background="#F7F9FD" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="查询卡密" Grid.Column="0" FontSize="12" Foreground="#55627A" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox x:Name="txtSearch" Grid.Column="1" Height="30" VerticalContentAlignment="Center"
                         ToolTip="输入卡密号 / 备注 / 绑定用户关键字，回车查询"/>
                <ui:FlatButton x:Name="btnSearch" Grid.Column="2" Content="查询" Width="80" Height="30" Margin="10,0,0,0"
                               Background="#2B5FDB" Foreground="White" Click="btnSearch_Click"/>
                <ui:FlatButton x:Name="btnResetSearch" Grid.Column="3" Content="全部" Width="70" Height="30" Margin="8,0,0,0"
                               Click="btnResetSearch_Click"/>
            </Grid>
        </Border>

        <!-- 卡密列表（实时刷新） -->
        <Border Grid.Row="3" Background="White" CornerRadius="8" BorderBrush="#E3E8F0" BorderThickness="1" Padding="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="6,2,6,6">
                    <TextBlock Text="卡密列表（每 5 秒自动刷新，到期实时显示「过期」）" FontSize="12" Foreground="#8A94A6" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtLastRefresh" Text="" FontSize="11" Foreground="#A8B0C4" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </DockPanel>
                <DataGrid x:Name="dgCards" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" FontSize="12" RowHeight="32">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="卡密号(32位UUID)" Binding="{Binding card_no}" Width="*"/>
                        <DataGridTextColumn Header="有效期" Binding="{Binding validity_text}" Width="76"/>
                        <DataGridTextColumn Header="状态" Binding="{Binding status_text}" Width="70"/>
                        <DataGridTextColumn Header="剩余时间" Binding="{Binding remain_text}" Width="94"/>
                        <DataGridTextColumn Header="到期时间" Binding="{Binding expire_at}" Width="145"/>
                        <DataGridTextColumn Header="生成时间" Binding="{Binding created_at}" Width="145"/>
                        <DataGridTextColumn Header="绑定用户" Binding="{Binding bind_user}" Width="140"/>
                        <DataGridTextColumn Header="备注" Binding="{Binding note}" Width="90"/>
                        <DataGridTemplateColumn Header="操作" Width="190">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="复制" Style="{StaticResource RowBtn}" Background="#2B5FDB" Click="btnCopy_Click" Tag="{Binding card_no}"/>
                                        <Button x:Name="btnEdit" Content="编辑" Style="{StaticResource RowBtn}" Background="#E89A00" Click="btnEdit_Click" Tag="{Binding card_no}"/>
                                        <Button x:Name="btnDelete" Content="删除" Style="{StaticResource RowBtn}" Background="#D93025" Click="btnDelete_Click" Tag="{Binding card_no}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>

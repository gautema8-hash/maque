<Window x:Class="MaoDuoDuo.Views.CardManageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:ZdfFlatUI;assembly=WPF.UI"
        Title="卡密管理" Height="560" Width="760"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize"
        Background="#EEF1F6" MouseLeftButtonDown="DragWindow">
    <Grid Margin="12">
        <Border Background="White" CornerRadius="8">
            <Grid Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 标题 -->
                <DockPanel Grid.Row="0" Margin="0,0,0,12">
                    <Image DockPanel.Dock="Right" Source="/DuoDuoPuHuo;component/images/win_close.png"
                           Width="16" Height="16" Cursor="Hand" MouseLeftButtonDown="CloseWindow_Click"/>
                    <TextBlock Text="卡密管理" FontSize="18" FontWeight="Bold" Foreground="#1F2A44"/>
                </DockPanel>

                <!-- 生成卡密 -->
                <Border Grid.Row="1" Background="#F7F9FD" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="卡密号" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12"/>
                        <TextBox x:Name="txtCardNo" Grid.Column="1" Height="30" VerticalContentAlignment="Center"
                                 ToolTip="留空自动生成"/>
                        <TextBlock Text="有效期" Grid.Column="2" VerticalAlignment="Center" Margin="12,0,6,0" FontSize="12"/>
                        <TextBox x:Name="txtValue" Grid.Column="3" Height="30" VerticalContentAlignment="Center" Text="1"/>
                        <ComboBox x:Name="comboUnit" Grid.Column="4" Height="30" Width="86" Margin="6,0,0,0" SelectedIndex="1">
                            <ComboBoxItem Content="小时" Tag="hour"/>
                            <ComboBoxItem Content="天" Tag="day"/>
                            <ComboBoxItem Content="月" Tag="month"/>
                            <ComboBoxItem Content="年" Tag="year"/>
                        </ComboBox>
                        <TextBlock Text="备注" Grid.Column="5" VerticalAlignment="Center" Margin="12,0,6,0" FontSize="12"/>
                        <TextBox x:Name="txtNote" Grid.Column="6" Height="30" Width="120" VerticalContentAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- 卡密列表 -->
                <DataGrid x:Name="dgCards" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" FontSize="12">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="卡密号" Binding="{Binding card_no}" Width="*"/>
                        <DataGridTextColumn Header="有效期" Binding="{Binding validity_text}" Width="90"/>
                        <DataGridTextColumn Header="状态" Binding="{Binding status_text}" Width="80"/>
                        <DataGridTextColumn Header="生成时间" Binding="{Binding created_at}" Width="150"/>
                        <DataGridTextColumn Header="到期时间" Binding="{Binding expire_at}" Width="150"/>
                        <DataGridTextColumn Header="绑定用户" Binding="{Binding bind_user}" Width="130"/>
                        <DataGridTextColumn Header="备注" Binding="{Binding note}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- 操作按钮 -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <ui:FlatButton Content="生成卡密" Width="110" Height="34" Background="#2B9F5F" Foreground="White"
                                   Click="btnGenerate_Click"/>
                    <ui:FlatButton Content="作废卡密" Width="110" Height="34" Margin="10,0,0,0"
                                   Click="btnDisable_Click"/>
                    <ui:FlatButton Content="刷新列表" Width="110" Height="34" Margin="10,0,0,0"
                                   Click="btnRefresh_Click"/>
                    <ui:FlatButton Content="关闭" Width="90" Height="34" Margin="10,0,0,0"
                                   Click="btnClose_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

<Window x:Class="MaoDuoDuo.Views.EditCardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:ZdfFlatUI;assembly=WPF.UI"
        Title="编辑卡密" Height="360" Width="520"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize"
        Background="#EEF1F6" MouseLeftButtonDown="DragWindow" Topmost="True">
    <Grid Margin="12">
        <Border Background="White" CornerRadius="8">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 标题 + 关闭 -->
                <DockPanel Grid.Row="0" Margin="0,0,0,16">
                    <Image DockPanel.Dock="Right" Source="/DuoDuoPuHuo;component/images/win_close.png"
                           Width="16" Height="16" Cursor="Hand" MouseLeftButtonDown="CloseWindow_Click"/>
                    <TextBlock Text="编辑卡密" FontSize="18" FontWeight="Bold" Foreground="#1F2A44"/>
                </DockPanel>

                <!-- 表单 -->
                <StackPanel Grid.Row="1">
                    <TextBlock Text="卡密号（32 位 UUID，不可修改）" FontSize="12" Foreground="#66708C" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtCardNo" Height="32" VerticalContentAlignment="Center" IsReadOnly="True"
                             Background="#F4F6FA" Foreground="#8A94A6" FontFamily="Consolas" FontSize="11"/>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="有效期" Grid.Column="0" FontSize="12" Foreground="#66708C" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox x:Name="txtValue" Grid.Column="1" Height="32" VerticalContentAlignment="Center" Text="1"/>
                        <ComboBox x:Name="comboUnit" Grid.Column="2" Height="32" Width="100" Margin="8,0,0,0" SelectedIndex="1" HorizontalAlignment="Left">
                            <ComboBoxItem Content="小时" Tag="hour"/>
                            <ComboBoxItem Content="天" Tag="day"/>
                            <ComboBoxItem Content="月" Tag="month"/>
                            <ComboBoxItem Content="年" Tag="year"/>
                        </ComboBox>
                    </Grid>
                    <TextBlock Text="状态" FontSize="12" Foreground="#66708C" Margin="0,12,0,4"/>
                    <ComboBox x:Name="comboStatus" Height="32" Width="160" HorizontalAlignment="Left" SelectedIndex="0">
                        <ComboBoxItem Content="未使用" Tag="active"/>
                        <ComboBoxItem Content="已使用" Tag="used"/>
                        <ComboBoxItem Content="已失效（作废）" Tag="disabled"/>
                    </ComboBox>
                    <TextBlock Text="备注" FontSize="12" Foreground="#66708C" Margin="0,12,0,4"/>
                    <TextBox x:Name="txtNote" Height="32" VerticalContentAlignment="Center"/>
                    <TextBlock Text="提示：修改有效期将以原创建时间为基准重新计算到期时间。" FontSize="10" Foreground="#A8B0C4" Margin="0,10,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- 按钮 -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                    <ui:FlatButton Content="取消" Width="90" Height="34" Click="btnCancel_Click"/>
                    <ui:FlatButton Content="保存" Width="90" Height="34" Margin="10,0,0,0"
                                   Background="#2B9F5F" Foreground="White" Click="btnSave_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

<Window x:Class="MaoDuoDuo.Views.ImageSet"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:ZdfFlatUI;assembly=WPF.UI"
        Title="图片设置" Height="360" Width="440"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize"
        Background="#F4F5F7" MouseLeftButtonDown="DragWindow">
    <Border Background="White" Margin="12" CornerRadius="6">
        <StackPanel Margin="20">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Image Source="/DuoDuoPuHuo;component/images/win_close.png" Width="16" Height="16" Cursor="Hand" MouseLeftButtonDown="CloseWindow_Click"/>
            </StackPanel>
            <TextBlock Text="底图选择" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>
            <ui:ZComboBox x:Name="box_bottom" Width="280" Height="32" SelectionChanged="bottom_SelectionChanged"/>
            <ui:FlatCheckBox x:Name="check_image1" Content="主图" Margin="0,14,0,0"/>
            <ui:FlatCheckBox x:Name="check_image2" Content="图片" Margin="0,10,0,0"/>
            <Image x:Name="image_tu" Width="220" Height="120" Margin="0,14,0,0" Stretch="Uniform"/>
        </StackPanel>
    </Border>
</Window>

<UserControl x:Class="MaoDuoDuo.Views.ShopSet"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:ZdfFlatUI;assembly=WPF.UI">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="2">
            <Border Width="90" Height="90" BorderBrush="#CCD" BorderThickness="1" Background="White">
                <Image x:Name="img_Login" Stretch="Uniform"/>
            </Border>
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <ui:FlatButton Content="获取二维码" Width="150" Height="34" Background="#2B5FDB" Foreground="White" Click="btnGetQRCode_Click"/>
                <Label x:Name="txt_State" Content="等待获取二维码" Margin="0,8,0,0"/>
                <TextBlock x:Name="txt_time" Text=""/>
                <TextBlock x:Name="txt_updateTime" Text=""/>
                <ui:FlatButton Content="统一更新cookie" Width="150" Height="34" Margin="0,8,0,0" Click="btnUpdate_Click"/>
            </StackPanel>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="2,8">
            <TextBlock Text="店铺筛选：" VerticalAlignment="Center"/>
            <ui:ZComboBox x:Name="shopType" Width="120" Height="30"/>
            <ui:IconTextBox x:Name="txt_shopName" Width="160" Height="30" Margin="10,0,0,0" Watermark="店铺名/手机号"/>
            <ui:FlatButton Content="查找店铺" Width="70" Height="30" Margin="10,0,0,0" Click="btnFind_Click"/>
            <ui:FlatButton Content="全选" Width="90" Height="30" Margin="10,0,0,0" Click="btnChoose_Click"/>
            <ui:FlatButton x:Name="txt_select" Content="选中使用店铺" Width="110" Height="30" Margin="10,0,0,0" Click="btnSelect_Click"/>
            <ui:FlatButton Content="删除失效店铺" Width="90" Height="30" Margin="10,0,0,0" Click="btnClear_Click"/>
        </StackPanel>
        <ui:FlatListView x:Name="PddShopList" Grid.Row="2" Margin="2,8">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="序号" DisplayMemberBinding="{Binding Num}" Width="40"/>
                    <GridViewColumn Header="店铺名称" DisplayMemberBinding="{Binding Name}" Width="150"/>
                    <GridViewColumn Header="店铺账号" DisplayMemberBinding="{Binding Mobile}" Width="110"/>
                    <GridViewColumn Header="状态" DisplayMemberBinding="{Binding Status}" Width="90"/>
                    <GridViewColumn Header="归属类目" DisplayMemberBinding="{Binding Staple}" Width="150"/>
                    <GridViewColumn Header="时间" DisplayMemberBinding="{Binding CreateTime}" Width="130"/>
                    <GridViewColumn Header="使用" Width="70">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox Checked="boxShop_Checked" Unchecked="boxShop_Checked"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ui:FlatListView>
        <ScrollViewer Grid.Row="3" Height="90" VerticalScrollBarVisibility="Auto">
            <RichTextBox x:Name="myRichTextBox" IsReadOnly="True" Background="#222" Foreground="#CF8">
                <FlowDocument>
                    <Paragraph>
                        <Run x:Name="txt_log" Text=""/>
                    </Paragraph>
                </FlowDocument>
            </RichTextBox>
        </ScrollViewer>
    </Grid>
</UserControl>

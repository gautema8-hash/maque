<Window x:Class="MaoDuoDuo.Views.ProductReviewsDownload"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:ZdfFlatUI;assembly=WPF.UI"
        Title="评论下载" Height="300" Width="520"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize"
        Background="#F4F5F7" MouseLeftButtonDown="DragWindow">
    <Border Background="White" Margin="12" CornerRadius="6">
        <StackPanel Margin="20">
            <DockPanel>
                <TextBlock Text="评价下载" FontSize="16" FontWeight="Bold"/>
                <Image DockPanel.Dock="Right" Source="/DuoDuoPuHuo;component/images/win_close.png" Width="16" Height="16" Cursor="Hand" MouseLeftButtonDown="CloseWindow_Click"/>
            </DockPanel>
            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                <TextBlock Text="保存路径：" VerticalAlignment="Center"/>
                <ui:ChooseBox x:Name="chsbSavePath" Width="320" Height="30" TextChanged="chsbSavePath_TextChanged"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                <TextBlock Text="下载数量：" VerticalAlignment="Center"/>
                <TextBox x:Name="txtDownloadCount" Width="120" Height="30" Text="100"/>
                <TextBlock Text="已下载数：" Margin="20,0,0,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="txtDownloadedCount" Text="0" VerticalAlignment="Center"/>
            </StackPanel>
            <ui:FlatProgressBar x:Name="downloadProgressBar" Height="16" Margin="0,16,0,0"/>
            <ui:FlatButton x:Name="btnDownloadReviews" Content="下载" Width="150" Height="40" Margin="0,18,0,0"
                           Background="#2B5FDB" Foreground="White" Click="btnDownloadReviews_Click"/>
        </StackPanel>
    </Border>
</Window>

<Window x:Class="MaoDuoDuo.Views.NoticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:ZdfFlatUI;assembly=WPF.UI"
        Title="公告" Height="300" Width="460"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize"
        Background="#F4F5F7" Loaded="NoticeWindow_Loaded">
    <Border Background="White" Margin="12" CornerRadius="6">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DockPanel>
                <Image DockPanel.Dock="Right" Source="/DuoDuoPuHuo;component/images/win_close.png" Width="16" Height="16" Cursor="Hand" MouseLeftButtonDown="Button_Click"/>
                <TextBlock x:Name="tbTitle" Text="公告标题" FontSize="16" FontWeight="Bold"/>
            </DockPanel>
            <TextBlock x:Name="tbDesc" Grid.Row="1" Text="" Foreground="#E85D2A" Margin="0,8,0,0" TextWrapping="Wrap"/>
            <TextBlock x:Name="tbContent" Grid.Row="2" Text="" Margin="0,8,0,0" TextWrapping="Wrap"/>
            <ui:PathTextButton x:Name="btn_show" Grid.Row="3" Content="查看详情" Width="90" Height="30" HorizontalAlignment="Right" Click="btn_show_Click"/>
        </Grid>
    </Border>
</Window>

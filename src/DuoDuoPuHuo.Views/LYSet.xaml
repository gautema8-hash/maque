<Window x:Class="DuoDuoPuHuo.Views.LYSet"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:ZdfFlatUI;assembly=WPF.UI"
        Title="自定义申诉理由" Height="280" Width="460"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize"
        Background="#F4F5F7" MouseLeftButtonDown="DragWindow">
    <Border Background="White" Margin="12" CornerRadius="6">
        <StackPanel Margin="16">
            <DockPanel>
                <TextBlock Text="自定义申诉理由（回车换行算一条）" FontSize="15" FontWeight="Bold"/>
                <Image DockPanel.Dock="Right" Source="/DuoDuoPuHuo;component/images/win_close.png" Width="16" Height="16" Cursor="Hand" MouseLeftButtonDown="CloseWindow_Click"/>
            </DockPanel>
            <ui:TitleTextBox x:Name="txt_reason" Height="110" Margin="0,14,0,0" AcceptsReturn="True" TextWrapping="Wrap"/>
            <ui:FlatButton Content="保存理由" Width="110" Height="38" Margin="0,16,0,0"
                           Background="#2B5FDB" Foreground="White" Click="btnSave_Click"/>
        </StackPanel>
    </Border>
</Window>

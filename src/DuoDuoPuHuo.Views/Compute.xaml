<Window x:Class="DuoDuoPuHuo.Views.Compute"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:ZdfFlatUI;assembly=WPF.UI"
        Title="盈亏计算" Height="460" Width="560"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize"
        Background="#F4F5F7" MouseLeftButtonDown="DragWindow">
    <Border Background="White" Margin="12" CornerRadius="6">
        <StackPanel Margin="20">
            <DockPanel>
                <TextBlock Text="盈亏计算" FontSize="16" FontWeight="Bold"/>
                <Image DockPanel.Dock="Right" Source="/DuoDuoPuHuo;component/images/win_close.png" Width="16" Height="16" Cursor="Hand" MouseLeftButtonDown="CloseWindow_Click"/>
            </DockPanel>
            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                </Grid.RowDefinitions>
                <TextBlock Text="销售价格：" VerticalAlignment="Center"/>
                <ui:IconTextBox x:Name="txt_xsjg" Grid.Column="1" Height="30" Text="0"/>
                <TextBlock Text="产品成本：" Grid.Column="2" VerticalAlignment="Center"/>
                <ui:IconTextBox x:Name="txt_cpcb" Grid.Column="3" Height="30" Text="0"/>
                <TextBlock Text="服务扣点(%)：" Grid.Column="4" VerticalAlignment="Center"/>
                <ui:IconTextBox x:Name="txt_fwkd" Grid.Column="5" Height="30" Text="0"/>
                <TextBlock Text="平均运费：" Grid.Row="1" VerticalAlignment="Center"/>
                <ui:IconTextBox x:Name="txt_pjyf" Grid.Row="1" Grid.Column="1" Height="30" Text="0"/>
                <TextBlock Text="赠品成本：" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center"/>
                <ui:IconTextBox x:Name="txt_zpcb" Grid.Row="1" Grid.Column="3" Height="30" Text="0"/>
                <TextBlock Text="退款率(%)：" Grid.Row="1" Grid.Column="4" VerticalAlignment="Center"/>
                <ui:IconTextBox x:Name="txt_tkl" Grid.Row="1" Grid.Column="5" Height="30" Text="0"/>
                <TextBlock Text="其他成本：" Grid.Row="2" VerticalAlignment="Center"/>
                <ui:IconTextBox x:Name="txt_qita" Grid.Row="2" Grid.Column="1" Height="30" Text="0"/>
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                <ui:FlatButton Content="计算ROI" Width="110" Height="36" Background="#2B5FDB" Foreground="White" Click="btnROI_Click"/>
                <TextBlock Text="实际投产ROI = " VerticalAlignment="Center"/>
                <TextBlock x:Name="txt_roi" Text="0" FontSize="18" FontWeight="Bold" Foreground="#2B9F5F" VerticalAlignment="Center"/>
            </StackPanel>
            <Separator Margin="0,16"/>
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="实际花费：" VerticalAlignment="Center"/>
                <ui:IconTextBox x:Name="txt_sjhf" Grid.Column="1" Height="30" Text="0"/>
                <TextBlock Text="实际投产：" Grid.Column="2" VerticalAlignment="Center"/>
                <ui:IconTextBox x:Name="txt_sjtc" Grid.Column="3" Height="30" Text="0"/>
                <TextBlock Text="保本投产：" Grid.Column="4" VerticalAlignment="Center"/>
                <ui:IconTextBox x:Name="txt_bbtc" Grid.Column="5" Height="30" Text="0"/>
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                <ui:FlatButton Content="计算推广盈亏" Width="120" Height="36" Background="#2B5FDB" Foreground="White" Click="btnTgyk_Click"/>
                <TextBlock Text="推广盈亏 = " VerticalAlignment="Center"/>
                <TextBlock x:Name="txt_tgyk" Text="0" FontSize="18" FontWeight="Bold" Foreground="#2B9F5F" VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>

<Window x:Class="MaoDuoDuo.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:ZdfFlatUI;assembly=WPF.UI"
        Title="麻雀一键铺货 - 登录"
        Height="380" Width="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize"
        Background="#F0F3F8"
        MouseLeftButtonDown="DragWindow">
    <Grid>
        <Border x:Name="Border1" CornerRadius="8" Background="White" Margin="16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.25"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="120"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" CornerRadius="8,8,0,0">
                    <Border.Background>
                        <ImageBrush x:Name="img_logo" Stretch="Uniform"/>
                    </Border.Background>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="麻雀一键铺货" FontSize="26" FontWeight="Bold" Foreground="#2B5FDB"/>
                        <TextBlock Text="拼多多商品一键采集 · 一键发布" FontSize="12" Foreground="#8A94A6" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border x:Name="border3" Grid.Row="1" Width="340" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="账号" Foreground="#556" FontSize="12" Margin="2,0"/>
                        <ui:IconTextBox x:Name="textAccount" Height="36" Margin="0,4,0,10"
                                        Watermark="请输入账号"/>
                        <TextBlock Text="密码" Foreground="#556" FontSize="12" Margin="2,0"/>
                        <ui:ZPasswordBox x:Name="textPwd" Height="36" Margin="0,4,0,14"
                                         Watermark="请输入密码"/>
                        <ui:ZCheckBox x:Name="btnCheck" Content="记住密码" Margin="2,0,0,14"/>
                        <ui:FlatButton x:Name="btnLogin" Content="登 录" Height="40" FontSize="15"
                                       Background="#2B5FDB" Foreground="White"
                                       Click="btnLogin_Click"/>
                        <TextBlock Text="本地授权版 · 任意账号密码即可登录" HorizontalAlignment="Center" Margin="0,14,0,0"
                                   FontSize="11" Foreground="#8A94A6"/>
                    </StackPanel>
                </Border>
                <Grid Grid.Row="2" Margin="8">
                    <Image Source="/DuoDuoPuHuo;component/images/win_close.png" Width="16" Height="16"
                           HorizontalAlignment="Right" Cursor="Hand"
                           MouseLeftButtonDown="CloseWindow_Click"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>

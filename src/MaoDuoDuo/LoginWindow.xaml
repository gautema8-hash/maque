<Window x:Class="MaoDuoDuo.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:ZdfFlatUI;assembly=WPF.UI"
        Title="麻雀一键铺货 - 登录"
        Height="480" Width="480"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True"
        MouseLeftButtonDown="DragWindow">
    <Window.Resources>
        <LinearGradientBrush x:Key="BgBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#16225C" Offset="0"/>
            <GradientStop Color="#2B5FDB" Offset="0.55"/>
            <GradientStop Color="#4C7DF0" Offset="1"/>
        </LinearGradientBrush>
        <DropShadowEffect x:Key="CardShadow" BlurRadius="24" ShadowDepth="4" Opacity="0.35" Color="#101E4E"/>
        <Style x:Key="FieldLbl" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#66708C"/>
            <Setter Property="Margin" Value="2,0,0,4"/>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource BgBrush}">
        <!-- 背景装饰 -->
        <Ellipse Width="260" Height="260" Fill="#FFFFFF" Opacity="0.06"
                 Margin="-80,-90,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Ellipse Width="320" Height="320" Fill="#FFFFFF" Opacity="0.05"
                 Margin="0,0,-110,-120" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
        <Ellipse Width="140" Height="140" Fill="#FFD166" Opacity="0.10"
                 Margin="40,0,0,60" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>

        <!-- 中央登录卡片 -->
        <Border Width="400" Height="410" Background="White" CornerRadius="14"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Effect="{StaticResource CardShadow}">
            <Grid Margin="34,20,34,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 品牌区 -->
                <StackPanel Grid.Row="0" HorizontalAlignment="Center">
                    <TextBlock Text="麻雀一键铺货" FontSize="23" FontWeight="Bold" Foreground="#1F2A44"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="拼多多商品一键采集 · 一键铺货" FontSize="11" Foreground="#8A94A6"
                               HorizontalAlignment="Center" Margin="0,3,0,0"/>
                </StackPanel>

                <!-- 登录方式切换 -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                    <ui:FlatButton x:Name="btnTabPassword" Content="账号密码登录" Width="150" Height="32"
                                   FontSize="13" Background="#2B5FDB" Foreground="White" CornerRadius="6"
                                   Click="btnTabPassword_Click"/>
                    <ui:FlatButton x:Name="btnTabCard" Content="卡密号登录" Width="150" Height="32"
                                   FontSize="13" Background="#E8EDF7" Foreground="#55627A" CornerRadius="6"
                                   Margin="8,0,0,0" Click="btnTabCard_Click"/>
                </StackPanel>

                <!-- 输入区：账号密码 -->
                <StackPanel x:Name="panelPassword" Grid.Row="2" Margin="0,14,0,0">
                    <TextBlock Style="{StaticResource FieldLbl}" Text="账号"/>
                    <ui:IconTextBox x:Name="textAccount" Height="36" Watermark="请输入账号"/>
                    <TextBlock Style="{StaticResource FieldLbl}" Text="密码" Margin="2,8,0,4"/>
                    <ui:ZPasswordBox x:Name="textPwd" Height="36" Watermark="请输入密码" IsCanSeePassword="True"/>
                </StackPanel>

                <!-- 输入区：卡密 -->
                <StackPanel x:Name="panelCard" Grid.Row="2" Margin="0,14,0,0" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource FieldLbl}" Text="卡密号"/>
                    <ui:IconTextBox x:Name="textCardNo" Height="36" Watermark="请输入卡密号"/>
                    <TextBlock Text="卡密有效期支持小时 / 天 / 月 / 年，过期、失效或已使用后无法登录"
                               FontSize="10" Foreground="#98A2B6" Margin="2,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- 错误提示条 -->
                <Border x:Name="errTip" Grid.Row="3" Background="#FFECEE" CornerRadius="6"
                        Padding="8,6" Margin="0,8,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="errTipText" Text="" FontSize="12" Foreground="#D93025" TextWrapping="Wrap"/>
                </Border>

                <!-- 记住密码（仅账号密码模式） -->
                <ui:ZCheckBox x:Name="btnCheck" Grid.Row="4" Content="记住密码" FontSize="12"
                              Foreground="#55627A" Margin="2,8,0,0"/>

                <!-- 登录按钮 -->
                <ui:FlatButton x:Name="btnLogin" Grid.Row="5" Content="登  录" Height="40" FontSize="15"
                               Background="#2B5FDB" Foreground="White" CornerRadius="8"
                               MouseOverBackground="#1E4FC4" PressedBackground="#173FA0"
                               Margin="0,12,0,0" Click="btnLogin_Click"/>

                <!-- 底部 -->
                <StackPanel Grid.Row="7" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,8,0,0">
                    <TextBlock x:Name="txtFooter" Text="本地授权版 v1.2 · 账号数据存储于本地 MySQL" FontSize="10"
                               Foreground="#A8B0C4" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 关闭按钮 -->
        <Image Source="/DuoDuoPuHuo;component/images/win_close.png" Width="18" Height="18"
               HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,14,0"
               Cursor="Hand" MouseLeftButtonDown="CloseWindow_Click"/>
    </Grid>
</Window>

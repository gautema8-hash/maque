<Window x:Class="MaoDuoDuo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MaoDuoDuo.Views"
        xmlns:ui="clr-namespace:ZdfFlatUI;assembly=WPF.UI"
        xmlns:cef="clr-namespace:CefSharp.Wpf;assembly=CefSharp.Wpf"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        Title="麻雀一键铺货"
        Height="900" Width="1440"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="#F4F5F7"
        KeyDown="Window_KeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="#2B5FDB" MouseLeftButtonDown="DragWindow">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                    <Image Source="/DuoDuoPuHuo;component/images/logo.png" Height="22" Margin="0,0,8,0"/>
                    <TextBlock Text="麻雀一键铺货" FontSize="15" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txt_Notice" Text="" FontSize="12" Foreground="#FFD" Margin="20,0,0,0" VerticalAlignment="Center" MaxWidth="700" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="有效期至：" FontSize="12" Foreground="#FFE" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txt_validity" Text="" FontSize="12" Foreground="#FFE" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <TextBlock x:Name="txt_Tips" Text="使用说明" FontSize="12" Foreground="#FFE" VerticalAlignment="Center" Margin="0,0,14,0" Cursor="Hand" MouseLeftButtonDown="TxtTips_Click"/>
                    <Image Source="/DuoDuoPuHuo;component/images/win_min.png" Width="16" Height="16" Margin="6,0" Cursor="Hand" MouseLeftButtonDown="MinWindow_Click"/>
                    <Image Source="/DuoDuoPuHuo;component/images/win_max.png" Width="16" Height="16" Margin="6,0" Cursor="Hand" MouseLeftButtonDown="MaxWindow_Click"/>
                    <Image Source="/DuoDuoPuHuo;component/images/win_close.png" Width="16" Height="16" Margin="6,0" Cursor="Hand" MouseLeftButtonDown="CloseWindow_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主体 -->
        <ui:ZTabControl x:Name="tab_main" Grid.Row="1" Margin="8,8,8,8" SelectionChanged="main_SelectionChanged"
                        Background="Transparent" BorderThickness="0">
            <!-- Tab 0: 任务设置 -->
            <TabItem Header="任务设置">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="360"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左侧：采集与发布参数 -->
                    <ScrollViewer x:Name="stackpanel1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="stackpanel9" Margin="4">
                            <WrapPanel Margin="2,0,0,4">
                                <TextBlock Text="操作类型：" VerticalAlignment="Center"/>
                                <ComboBox x:Name="box_type" Width="120" Height="30" SelectionChanged="type_SelectionChanged"/>
                                <TextBlock Text="裂变数量：" Margin="16,0,0,0" VerticalAlignment="Center"/>
                                <ui:IntegerUpDown x:Name="txt_num" Width="90" Height="30" Visibility="Hidden"/>
                                <TextBlock Text="白底图：" Margin="16,0,0,0" VerticalAlignment="Center"/>
                                <ComboBox x:Name="box_type6" Width="120" Height="30" SelectedIndex="0"><ComboBoxItem Content="不处理"/><ComboBoxItem Content="生成白底图"/></ComboBox>
                            </WrapPanel>
                            <WrapPanel Margin="2,4">
                                <TextBlock Text="上传到：" VerticalAlignment="Center"/>
                                <ui:ZComboBox x:Name="box_up" Width="120" Height="30"/>
                                <TextBlock Text="商品分类：" Margin="16,0,0,0" VerticalAlignment="Center"/>
                                <ui:IconTextBox x:Name="txt_shopType" Width="220" Height="30" Watermark="数码电器>3C数码配件>手机配件>手机贴膜"/>
                                <ui:FlatCheckBox x:Name="check_type" Content="自动分类" Margin="10,0,0,0" Click="CheckBox_Type"/>
                            </WrapPanel>
                            <WrapPanel Margin="2,4">
                                <TextBlock Text="主图设置：" VerticalAlignment="Center"/>
                                <ui:ZComboBox x:Name="box_image" Width="140" Height="30"/>
                                <ui:FlatCheckBox x:Name="check_delete" Content="删除第一张主图" Margin="16,0,0,0"/>
                                <TextBlock Text="删除详情前：" Margin="16,0,0,0" VerticalAlignment="Center"/>
                                <ui:IntegerUpDown x:Name="txt_del1" Width="70" Height="30"/>
                                <TextBlock Text="删除详情后：" VerticalAlignment="Center"/>
                                <ui:IntegerUpDown x:Name="txt_del2" Width="70" Height="30"/>
                            </WrapPanel>
                            <WrapPanel Margin="2,4">
                                <TextBlock Text="运费模板：" VerticalAlignment="Center"/>
                                <ui:ZComboBox x:Name="box_freight" Width="170" Height="30"/>
                                <TextBlock Text="是否预售：" Margin="16,0,0,0" VerticalAlignment="Center"/>
                                <ui:ZComboBox x:Name="box_sale" Width="120" Height="30" SelectionChanged="sale_SelectionChanged"/>
                                <ui:IntegerUpDown x:Name="txt_saleDay" Width="70" Height="30"/>
                                <Label x:Name="txt_saleDay1" Content="天后发货" VerticalAlignment="Center"/>
                                <TextBlock Text="发货时间：" Margin="16,0,0,0" VerticalAlignment="Center"/>
                                <ui:ZComboBox x:Name="box_time" Width="100" Height="30"/>
                            </WrapPanel>
                            <WrapPanel Margin="2,4">
                                <TextBlock Text="品牌属性：" VerticalAlignment="Center"/>
                                <ui:ZComboBox x:Name="box_brand" Width="110" Height="30"/>
                                <TextBlock Text="店铺名称：" Margin="16,0,0,0" VerticalAlignment="Center"/>
                                <ui:IconTextBox x:Name="txt_shopName" Width="160" Height="30" Watermark="选填"/>
                            </WrapPanel>
                            <WrapPanel Margin="2,4">
                                <TextBlock Text="库存设置：" VerticalAlignment="Center"/>
                                <ui:ZComboBox x:Name="box_inventory" Width="110" Height="30" SelectionChanged="inventory_SelectionChanged"/>
                                <TextBlock Text="固定库存：" Margin="16,0,0,0" VerticalAlignment="Center"/>
                                <ui:IconTextBox x:Name="txt_inventory" Width="100" Height="30" Watermark="0"/>
                                <TextBlock Text="最低价库存：" Margin="16,0,0,0" VerticalAlignment="Center"/>
                                <ui:IconTextBox x:Name="txt_minku" Width="100" Height="30" Watermark="留空不启用"/>
                                <TextBlock Text="库存低于：" Margin="16,0,0,0" VerticalAlignment="Center"/>
                                <ui:IntegerUpDown x:Name="txt_under" Width="70" Height="30"/>
                            </WrapPanel>
                            <WrapPanel Margin="2,4">
                                <TextBlock Text="编号：" VerticalAlignment="Center"/>
                                <ui:ZComboBox x:Name="box_code" Width="130" Height="30"/>
                                <TextBlock Text="商品编码：" Margin="16,0,0,0" VerticalAlignment="Center"/>
                                <ui:ZComboBox x:Name="box_sku" Width="130" Height="30"/>
                                <TextBlock Text="前缀：" Margin="16,0,0,0" VerticalAlignment="Center"/>
                                <ui:IconTextBox x:Name="txt_sku1" Width="80" Height="30" Watermark=""/>
                                <TextBlock Text="后缀：" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                <ui:IconTextBox x:Name="txt_sku2" Width="80" Height="30" Watermark=""/>
                            </WrapPanel>
                            <WrapPanel Margin="2,4">
                                <TextBlock Text="保存路径：" VerticalAlignment="Center"/>
                                <ui:ChooseBox x:Name="chsbSavePath" Width="220" Height="30"/>
                                <TextBlock Text="图片处理：" Margin="16,0,0,0" VerticalAlignment="Center"/>
                                <ui:ZComboBox x:Name="box_alter" Width="120" Height="30" SelectionChanged="alter_SelectionChanged"/>
                                <ui:FlatButton x:Name="btn_lbset" Content="设置" Height="30" Margin="10,0,0,0" Click="btnLBSet_Click"/>
                                <ComboBox x:Name="box_tu" Width="70" Height="30" Visibility="Hidden"/>
                            </WrapPanel>
                            <WrapPanel Margin="2,4">
                                <ui:FlatCheckBox x:Name="isFront" Content="加前缀"/>
                                <ui:IconTextBox x:Name="txt_front" Width="180" Height="30" Margin="6,0"/>
                                <ui:FlatCheckBox x:Name="isAfter" Content="加后缀"/>
                                <ui:IconTextBox x:Name="txt_after" Width="180" Height="30" Margin="6,0"/>
                            </WrapPanel>
                            <WrapPanel Margin="2,4">
                                <ui:TitleTextBox x:Name="txt_title" Width="380" Height="40" Title="替换标题（每行: 旧=新）"/>
                                <StackPanel Margin="10,0,0,0">
                                    <ui:FlatCheckBox x:Name="isSkuName" Content="同时替换SKU"/>
                                    <ui:TitleTextBox x:Name="txt_keyword" Width="240" Height="52" Title="过滤关键词（每行一个）"/>
                                    <ui:FlatCheckBox x:Name="isSkuKeyword" Content="同时过滤SKU"/>
                                </StackPanel>
                            </WrapPanel>
                            <WrapPanel Margin="2,4">
                                <TextBlock Text="商品改价：" VerticalAlignment="Center"/>
                                <ui:ZComboBox x:Name="box_change" Width="110" Height="30" SelectionChanged="change_SelectionChanged"/>
                                <ui:IconTextBox x:Name="txt_change" Width="90" Height="30" Margin="6,0" Text="8"/>
                                <Label x:Name="txt_unit" Content="%" VerticalAlignment="Center"/>
                                <ui:FlatCheckBox x:Name="isGroup" Content="单买价" Margin="10,0,0,0"/>
                                <ui:ZComboBox x:Name="box_group" Width="60" Height="30"/>
                                <ui:IconTextBox x:Name="txt_group" Width="70" Height="30" Margin="6,0"/>
                                <TextBlock Text="裂变价格公式：" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                <ui:IconTextBox x:Name="txt_liebian" Width="180" Height="30" Watermark="A +2+ B * 0.02" GotFocus="TxtTips_Click"/>
                            </WrapPanel>
                            <WrapPanel Margin="2,4">
                                <ui:TitleTextBox x:Name="txt_normal" Width="380" Height="52" Title="属性匹配（每行: 源属性=目标属性;目标属性2）" GotFocus="TxtTips_Click"/>
                                <ui:TitleTextBox x:Name="txt_fill" Width="300" Height="52" Margin="10,0,0,0" Title="属性填充（每行: 属性=值1;值2）" GotFocus="TxtTips_Click"/>
                                <ui:FlatCheckBox x:Name="isFill" Content="强制替换商品属性" Margin="10,0,0,0"/>
                            </WrapPanel>
                            <StackPanel x:Name="stackpanel5" Orientation="Horizontal" Margin="2,10">
                                <ui:FlatButton x:Name="btnPublish" Content="开始上传" Width="110" Height="40" Background="#2B9F5F" Foreground="White" FontSize="14" Click="btnPublish_Click"/>
                                <ui:FlatButton x:Name="btn_pause" Content="暂停" Width="80" Height="40" Margin="10,0,0,0" Click="btnPause_Click"/>
                                <ui:FlatButton x:Name="btnEnd" Content="停止" Width="80" Height="40" Margin="10,0,0,0" Click="btnEnd_Click"/>
                                <ui:FlatButton x:Name="btnLogin2" Content="登录买手号" Width="110" Height="40" Margin="10,0,0,0" Click="btnLogin_Click"/>
                                <ui:FlatButton x:Name="btnSHLogin" Content="扫码商户" Width="90" Height="40" Margin="10,0,0,0" Click="btnSHLogin_Click"/>
                            </StackPanel>
                            <StackPanel x:Name="stackpanel2" Margin="2,4">
                                <ui:TitleTextBox x:Name="txt_goodId" Height="80" Title="商品ID列表（每行一个）"/>
                                <ui:TitleTextBox x:Name="txt_goodId1" Height="60" Margin="0,6,0,0" Title="完成商品ID" IsReadOnly="True"/>
                            </StackPanel>
                            <WrapPanel Margin="2,4">
                                <ui:FlatCheckBox x:Name="check_jump" Content="跳过商品编辑"/>
                                <ui:FlatCheckBox x:Name="check_ceshi" Content="获取商品失败后使用测试数据" Margin="16,0,0,0"/>
                                <TextBlock Text="延迟(秒)：" Margin="16,0,0,0" VerticalAlignment="Center"/>
                                <ui:IconTextBox x:Name="txt_yanchi" Width="60" Height="30"/>
                                <TextBlock Text="间隔(秒)：" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                <ui:IconTextBox x:Name="txt_jiange" Width="60" Height="30"/>
                            </WrapPanel>
                            <WrapPanel Margin="2,4">
                                <ui:FlatButton Content="一键卡大促" Height="34" Click="btnKDC_Click"/>
                                <ui:FlatButton Content="仅退款申诉2" Height="34" Margin="10,0,0,0" Click="btnJTK_Click2"/>
                                <ui:FlatButton Content="卡反拼单" Height="34" Margin="10,0,0,0" Click="btnCeshi_Click"/>
                                <ui:FlatButton Content="批量下架" Height="34" Margin="10,0,0,0" Click="btnOff_Click"/>
                                <ui:FlatButton Content="申诉理由" Height="34" Margin="10,0,0,0" Click="btnSSLY_Click"/>
                                <ui:FlatButton Content="仅退款申诉" Height="34" Margin="10,0,0,0" Click="btnJTK_Click"/>
                                <ui:FlatButton Content="盈亏计算" Height="34" Margin="10,0,0,0" Click="btnCompute_Click"/>
                            </WrapPanel>
                            <WrapPanel Margin="2,4">
                                <ui:FlatCheckBox x:Name="choose1" Content="主图视频同步"/>
                                <ui:FlatCheckBox x:Name="choose2" Content="详情视频同步" Margin="10,0,0,0"/>
                                <ui:FlatCheckBox x:Name="choose3" Content="SKU图片同步" Margin="10,0,0,0"/>
                                <ui:FlatCheckBox x:Name="choose4" Content="单规格商品跳过" Margin="10,0,0,0"/>
                                <ui:FlatCheckBox x:Name="choose5" Content="团购价低于10元库存置0" Margin="10,0,0,0"/>
                            </WrapPanel>
                            <WrapPanel Margin="2,4">
                                <ui:FlatCheckBox x:Name="choose6" Content="跳过限购商品"/>
                                <ui:FlatCheckBox x:Name="choose7" Content="标题去重复" Margin="10,0,0,0"/>
                                <ui:FlatCheckBox x:Name="choose8" Content="属性智能映射" Margin="10,0,0,0"/>
                                <ui:FlatCheckBox x:Name="choose9" Content="上传成功自动下一条"/>
                                <ui:FlatCheckBox x:Name="choose10" Content="失败自动重试"/>
                                <ui:FlatCheckBox x:Name="choose11" Content="保留原货号"/>
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 右侧：店铺列表 + 日志 -->
                    <StackPanel x:Name="stackpanel3" Grid.Column="1" Margin="8,0,4,0">
                        <StackPanel x:Name="stackpanel4">
                            <ui:FlatListView x:Name="PddShopList" Height="220">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="序号" DisplayMemberBinding="{Binding Num}" Width="40"/>
                                        <GridViewColumn Header="原商品ID" DisplayMemberBinding="{Binding GoodId}" Width="120"/>
                                        <GridViewColumn Header="上传后ID" DisplayMemberBinding="{Binding GoodId2}" Width="120"/>
                                        <GridViewColumn Header="时间" DisplayMemberBinding="{Binding UploadTime}" Width="130"/>
                                        <GridViewColumn Header="上传结果" DisplayMemberBinding="{Binding Result}" Width="120"/>
                                    </GridView>
                                </ListView.View>
                                <ListView.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="删除勾选" Click="DeleteMenuItem_Click"/>
                                        <MenuItem Header="删除所有" Click="DeleteMenuAll_Click"/>
                                    </ContextMenu>
                                </ListView.ContextMenu>
                            </ui:FlatListView>
                        </StackPanel>
                        <TextBlock Text="运行日志" Margin="0,8,0,2"/>
                        <ScrollViewer x:Name="scrollViewer" Height="200">
                            <RichTextBox x:Name="myRichTextBox" IsReadOnly="True" Background="#222" Foreground="#CF8">
                                <FlowDocument>
                                    <Paragraph>
                                        <Run x:Name="txt_log" Text=""/>
                                    </Paragraph>
                                </FlowDocument>
                            </RichTextBox>
                        </ScrollViewer>
                        <TextBlock Text="上传失败" Margin="0,8,0,2"/>
                        <ScrollViewer x:Name="scrollViewer1" Height="120">
                            <RichTextBox x:Name="myRichTextBox1" IsReadOnly="True" Background="#222" Foreground="#F87">
                                <FlowDocument>
                                    <Paragraph>
                                        <Run x:Name="txt_log1" Text=""/>
                                    </Paragraph>
                                </FlowDocument>
                            </RichTextBox>
                        </ScrollViewer>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Tab 1: 前端采集页（买手号） -->
            <TabItem Header="买手页">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="4">
                        <ui:FlatButton x:Name="btnBrowserGoBack" Content="←" Width="34" Height="30" Click="btnBrowserGoBack_Click"/>
                        <ui:FlatButton x:Name="btnBrowserGoForward" Content="→" Width="34" Height="30" Margin="4,0,0,0" Click="btnBrowserGoForward_Click"/>
                        <ui:FlatButton x:Name="btnBrowserStop" Content="✕" Width="34" Height="30" Margin="4,0,0,0" Click="btnBrowserStop_Click"/>
                        <ui:FlatButton x:Name="btnBrowserRefresh" Content="⟳" Width="34" Height="30" Margin="4,0,0,0" Click="btnBrowserRefresh_Click"/>
                        <ui:FlatButton x:Name="btnBrowserHome" Content="⌂" Width="34" Height="30" Margin="4,0,0,0" Click="btnBrowserHome_Click"/>
                        <TextBox x:Name="txtBrowser" Width="520" Height="30" Margin="8,0,0,0" VerticalContentAlignment="Center"/>
                        <ui:FlatButton x:Name="btnBrowserGoto" Content="跳转" Width="60" Height="30" Margin="6,0,0,0" Click="btnBrowserGoto_Click"/>
                        <ui:FlatProgressBar x:Name="browserProgressBar" Width="120" Height="14" Margin="12,0,0,0"/>
                        <ui:FlatButton Content="商品信息" Width="76" Height="30" Margin="10,0,0,0" Click="btnProductInfoShow_Click"/>
                        <ui:FlatButton Content="评价下载" Width="76" Height="30" Margin="8,0,0,0" Click="BtnReviewDownload_OnClick"/>
                    </StackPanel>
                    <Border x:Name="bdrBrowser" Grid.Row="1" Margin="4" Background="White">
                        <cef:ChromiumWebBrowser x:Name="browser"/>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Tab 2: 商家发布页 -->
            <TabItem Header="商户页">
                <Grid>
                    <Border x:Name="bdrBrowser1" Background="White">
                        <Grid>
                            <cef:ChromiumWebBrowser x:Name="browser1"/>
                            <cef:ChromiumWebBrowser x:Name="browser2" Visibility="Hidden"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Tab 3: 售后服务 -->
            <TabItem Header="售后服务">
                <Border x:Name="bdrBrowser3" Background="White">
                    <cef:ChromiumWebBrowser x:Name="browser3"/>
                </Border>
            </TabItem>

            <!-- Tab 4: 首页（热搜/直连入口/行情） -->
            <TabItem Header="首页">
                <views:Home/>
            </TabItem>

            <!-- Tab 5: 店铺管理（扫码登录/店铺列表） -->
            <TabItem Header="店铺管理">
                <views:ShopSet/>
            </TabItem>

            <!-- Tab 6: 商品监控 -->
            <TabItem Header="商品监控">
                <views:GoodManager/>
            </TabItem>

            <!-- Tab 7: 视频采集（抖音/快手） -->
            <TabItem Header="视频采集">
                <views:VideoCapture/>
            </TabItem>

            <!-- Tab 8: 工具箱 -->
            <TabItem Header="工具箱">
                <views:Toolbox/>
            </TabItem>
        </ui:ZTabControl>
    </Grid>
</Window>

<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>DuoDuoPuHuo</AssemblyName>
    <RootNamespace>MaoDuoDuo</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <LangVersion>latest</LangVersion>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <NoWarn>NU1701;CS0168;CS0219;CS8632;CS0618;CS4014</NoWarn>
    <ApplicationIcon>AppData\logo.ico</ApplicationIcon>
    <EnableDefaultItems>false</EnableDefaultItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="MySql.Data" Version="8.0.33" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="MaoDuoDuo\**\*.cs" />
    <Compile Include="MaoDuoDuo.Views\**\*.cs" />
    <Compile Remove="MaoDuoDuo.Views\WorkOrder.cs" />
    <Compile Include="DuoDuoPuHuo.Views\**\*.cs" />
    <Compile Include="MaoDuoDuo.Web\**\*.cs" />
    <Compile Include="DuoDuoPuHuo.Properties\**\*.cs" />
    <Compile Include="MDD.BLL\**\*.cs" />
    <Compile Include="MDD.DAL\**\*.cs" />
    <Compile Include="MDD.Models\**\*.cs" />
    <Compile Include="MDD.Common\**\*.cs" />
    <Compile Include="MDD.Utility\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Page Include="MaoDuoDuo\*.xaml" />
    <Page Include="MaoDuoDuo.Views\*.xaml" />
    <Page Include="DuoDuoPuHuo.Views\*.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="images\**\*" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Configuration" />
    <Reference Include="System.Data.DataSetExtensions" />
    <Reference Include="System.Web" />
    <Reference Include="CefSharp">
      <HintPath>libs\CefSharp.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="CefSharp.Core">
      <HintPath>libs\CefSharp.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="CefSharp.Wpf">
      <HintPath>libs\CefSharp.Wpf.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>libs\Newtonsoft.Json.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="log4net">
      <HintPath>libs\log4net.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.Data.SQLite">
      <HintPath>libs\System.Data.SQLite.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="OpenCvSharp">
      <HintPath>libs\OpenCvSharp.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="OpenCvSharp.Blob">
      <HintPath>libs\OpenCvSharp.Blob.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="OpenCvSharp.Extensions">
      <HintPath>libs\OpenCvSharp.Extensions.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="OpenCvSharp.UserInterface">
      <HintPath>libs\OpenCvSharp.UserInterface.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Tesseract">
      <HintPath>libs\Tesseract.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="LiveCharts">
      <HintPath>libs\LiveCharts.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="LiveCharts.Wpf">
      <HintPath>libs\LiveCharts.Wpf.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="WPF.UI">
      <HintPath>libs\WPF.UI.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="WPF.UI.VideoPlayer">
      <HintPath>libs\WPF.UI.VideoPlayer.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="WPFSoundVisualizationLib">
      <HintPath>libs\WPFSoundVisualizationLib.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="WpfAnimatedGif">
      <HintPath>libs\WpfAnimatedGif.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="AutoUpdater.NET">
      <HintPath>libs\AutoUpdater.NET.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.Linq.Dynamic.Core">
      <HintPath>libs\System.Linq.Dynamic.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.Drawing.Common">
      <HintPath>libs\System.Drawing.Common.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.Web.WebView2.Core">
      <HintPath>libs\Microsoft.Web.WebView2.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.Web.WebView2.WinForms">
      <HintPath>libs\Microsoft.Web.WebView2.WinForms.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Content Include="AppData\cate.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="AppData\mddph.sqlite" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="AppData\setting.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="AppData\logo.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="AppData\Resources\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
